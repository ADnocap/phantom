\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Main results. (a)\nonbreakingspace Rank IC increases with horizon, consistent with drift SNR $\propto \sqrt  {h}$ (longer horizons also overlap more heavily). (b)\nonbreakingspace Cumulative overlapping 10-day long-short spreads under different cost assumptions---indicative of signal strength, not an implementable equity curve. (c)\nonbreakingspace Decile portfolio returns are near-perfectly monotonic (Spearman 0.988). (d)\nonbreakingspace Phantom attains the highest IC among directional baselines; the naive low-volatility sort achieves a higher raw IC (Section\nonbreakingspace 5.4).}}{6}{figure.caption.19}\protected@file@percent }
\newlabel{fig:main}{{2}{6}{Main results. (a)~Rank IC increases with horizon, consistent with drift SNR $\propto \sqrt {h}$ (longer horizons also overlap more heavily). (b)~Cumulative overlapping 10-day long-short spreads under different cost assumptions---indicative of signal strength, not an implementable equity curve. (c)~Decile portfolio returns are near-perfectly monotonic (Spearman 0.988). (d)~Phantom attains the highest IC among directional baselines; the naive low-volatility sort achieves a higher raw IC (Section~5.4)}{figure.caption.19}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5}Distributional Quality}{6}{subsection.5.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Baseline comparison (h=10d). Sharpe ratios are gross and horizon-corrected; Win\% is over overlapping 10-day windows.}}{7}{table.caption.22}\protected@file@percent }
\newlabel{tab:baselines}{{5}{7}{Baseline comparison (h=10d). Sharpe ratios are gross and horizon-corrected; Win\% is over overlapping 10-day windows}{table.caption.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces (a)\nonbreakingspace Double sort: mean daily returns by volatility and Phantom tercile. The volatility column dominates (low-vol assets earn positive returns regardless of Phantom ranking), but Phantom's long-short spread is significant within mid-vol ($t\,{=}\,$2.6) and high-vol ($t\,{=}\,$4.1) terciles. (b)\nonbreakingspace Combining both signals yields the highest IC.}}{7}{figure.caption.23}\protected@file@percent }
\newlabel{fig:ortho}{{3}{7}{(a)~Double sort: mean daily returns by volatility and Phantom tercile. The volatility column dominates (low-vol assets earn positive returns regardless of Phantom ranking), but Phantom's long-short spread is significant within mid-vol ($t\,{=}\,$2.6) and high-vol ($t\,{=}\,$4.1) terciles. (b)~Combining both signals yields the highest IC}{figure.caption.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Distributional quality. (a)\nonbreakingspace PIT histogram (h=10d) is approximately uniform. (b)\nonbreakingspace Coverage calibration closely tracks the diagonal. (c)\nonbreakingspace Predicted $\mitsigma $ follows $\sqrt  {h}$ scaling at short horizons.}}{7}{figure.caption.24}\protected@file@percent }
\newlabel{fig:dist}{{4}{7}{Distributional quality. (a)~PIT histogram (h=10d) is approximately uniform. (b)~Coverage calibration closely tracks the diagonal. (c)~Predicted $\sigma $ follows $\sqrt {h}$ scaling at short horizons}{figure.caption.24}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.6}Robustness}{7}{subsection.5.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Robustness. (a)\nonbreakingspace Monthly IC is positive in all 15 months. (b)\nonbreakingspace 60-day rolling horizon-corrected Sharpe always positive (min ${\approx }\,0.9$). (c)\nonbreakingspace Turnover stable at 38\%.}}{7}{figure.caption.25}\protected@file@percent }
\newlabel{fig:robust}{{5}{7}{Robustness. (a)~Monthly IC is positive in all 15 months. (b)~60-day rolling horizon-corrected Sharpe always positive (min ${\approx }\,0.9$). (c)~Turnover stable at 38\%}{figure.caption.25}{}}
